# Settings for docker-compose.yml. Copy this file to .env (which git ignores) before the first
# "docker compose up"; "npm run api:up" does that for you. Local development only: the database and
# the API listen on 127.0.0.1, never on your network.
#
# Use letters, digits, "-" and "_" in the user, password and database name: they go into a URL.
POSTGRES_USER=gkod
POSTGRES_PASSWORD=gkod-local-dev
POSTGRES_DB=gkod

# Ports on 127.0.0.1 for the database and the API.
GKOD_DB_PORT=5432
GKOD_API_PORT=8000

# For the loader and the tests run from your own shell against the compose database
# (export it, or put it in front of the command). Keep it in step with the values above.
DATABASE_URL=postgresql://gkod:gkod-local-dev@127.0.0.1:5432/gkod
